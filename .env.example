# Copie para .env.local e preencha. Nada aqui é obrigatório para rodar em dev.

# WhatsApp (apenas dígitos, com DDI+DDD). Ex.: 5521999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics — sem isso, os scripts simplesmente não carregam
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Banco (qubit_site) ────────────────────────────────────────────────────────
# Produção (Cloud Run): use o socket do Cloud SQL — defina INSTANCE_CONNECTION_NAME
# (PROJETO:REGIAO:INSTANCIA) + DB_NAME/DB_USER/DB_PASSWORD.
# Dev: use DATABASE_URL (Postgres local ou cloud-sql-proxy em 127.0.0.1).
INSTANCE_CONNECTION_NAME=
DB_NAME=qubit_site
DB_USER=qubit_site_app
DB_PASSWORD=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qubit_site

# E-mail que vira ADMIN do portal ao se cadastrar (padrão Economicon).
OWNER_EMAIL=

# Bucket público do Cloud Storage para as logos das empresas.
LOGOS_BUCKET=

# ── Gestão API (hub financeiro/comercial) ────────────────────────────────────
# O formulário /diagnostico cria o lead no pipeline. Sem as envs, não envia.
GESTAO_API_URL=
GESTAO_API_KEY=

# Webhook opcional do formulário (POST JSON) — ex.: notificação Slack/WhatsApp.
# Sem Gestão nem webhook, em dev o lead é apenas logado no console.
FORM_SUBMISSION_WEBHOOK=
